{
  "name": "tripflip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:catalog": "python3 -m unittest discover -s tests -p \"catalog*.py\"",
    "test:e2e": "playwright test",
    "catalog:extract": "node --experimental-strip-types scripts/catalog/extract.mjs",
    "catalog:build": "python3 scripts/catalog/pipeline.py build",
    "catalog:import": "python3 scripts/catalog/pipeline.py import",
    "dining:build": "python3 scripts/catalog/dining.py"
  },
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
